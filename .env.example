# ───────────── Server ─────────────
NODE_ENV=development                       # development | production
PORT=4000                                  # API port
API_PREFIX=api                             # all routes are mounted under /api
FRONTEND_ORIGIN=http://localhost:3000      # CORS whitelist + base for email links (prod: https://your-app.vercel.app)
LOG_LEVEL=debug                            # winston level: debug | info | warn | error
SWAGGER_ENABLED=true                       # expose /api/docs (set false in prod)

APP_NAME=Joblens

# ───────────── Database (PostgreSQL) ─────────────
# Local: postgresql://user:pass@localhost:5432/joblens?schema=public
# Cloud (Neon/Supabase/RDS): paste the full connection string (often needs ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joblens?schema=public   # <REPLACE_DB_URL>

# ───────────── Redis (cache + BullMQ + pub/sub) ─────────────
# Option A — discrete fields (local):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                            # empty locally; set for Redis Cloud
REDIS_TLS=false                            # true for most managed Redis (Redis Cloud/Upstash)
# Option B — single URL (managed): if set, it takes precedence over the fields above
REDIS_URL=                                 # e.g. rediss://default:<pass>@host:port   <REPLACE_IF_CLOUD>

# ───────────── Auth / JWT ─────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me      # <REPLACE_WITH_LONG_RANDOM_STRING>
JWT_ACCESS_TTL=15m                                 # access token lifetime
JWT_REFRESH_SECRET=dev_refresh_secret_change_me    # <REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING>
JWT_REFRESH_TTL=7d                                 # refresh token lifetime
BCRYPT_SALT_ROUNDS=12                              # password hashing cost

# ───────────── Refresh-token cookie ─────────────
REFRESH_COOKIE_NAME=joblens_rt
COOKIE_SECURE=false                        # true in production (HTTPS required)
COOKIE_SAMESITE=lax                        # lax for same-site dev; "none" when FE/BE are on different domains (prod)
COOKIE_DOMAIN=                             # leave empty for localhost; set parent domain in prod if needed

# ───────────── Job data sources (RapidAPI — multi-source) ─────────────
# One shared RapidAPI key powers all source adapters (each hard-codes its host):
#   linkedin-job-search-api, active-jobs-db, jobicy, indeed12, remote-jobs1, jsearch.p.rapidapi.com.
# QUERY → title filter, COUNTRY → location, DATE_POSTED → time_frame. PAGES applies per source.
JSEARCH_API_KEY=<REPLACE_WITH_RAPIDAPI_KEY>        # from https://rapidapi.com/
JSEARCH_API_HOST=linkedin-job-search-api.p.rapidapi.com
JSEARCH_QUERY='"Software Engineer" OR "Backend" OR "Frontend" OR "Full Stack" OR "Developer" OR "Software Developer"'
JSEARCH_COUNTRY=bd                         # ISO country code → mapped to a location (bd → Bangladesh)
JSEARCH_DATE_POSTED=week                   # today(24h) | 3days(7d) | week(7d) | month(6m)
JSEARCH_PAGES=2                            # pages fetched per source per run (10 jobs/page) — keep low to respect RapidAPI quotas
INGESTION_TIMEZONE=Asia/Dhaka             # cron timezone for the 4 daily fetches
JOB_RETENTION_DAYS=30                      # jobs unseen this many days are deleted by the purge job (saved/applied jobs kept)

# ───────────── JSearch RapidAPI (jsearch.p.rapidapi.com — /search + /job-details) ─────────────
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
JSEARCH_RAPIDAPI_FETCH_DETAILS=true           # fetch /job-details when search description is short
JSEARCH_RAPIDAPI_MAX_DETAIL_FETCHES=10        # cap detail calls per ingestion run

# ───────────── Email (SMTP via Nodemailer) ─────────────
# Local dev tip: use Mailtrap/Ethereal credentials so emails are captured, not sent.
SMTP_HOST=<REPLACE_SMTP_HOST>             # e.g. sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false                          # true if using port 465
SMTP_USER=<REPLACE_SMTP_USER>
SMTP_PASS=<REPLACE_SMTP_PASS>
MAIL_FROM="Joblens <no-reply@joblens.app>"   # default From header

# ───────────── Rate limiting (@nestjs/throttler) ─────────────
RATE_LIMIT_TTL=900                         # window in seconds (15 min)
RATE_LIMIT_MAX=100                         # max requests per window per IP

# ───────────── Default admin (created once on server start if missing) ─────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@joblens.app          # <REPLACE_FOR_REAL_ADMIN>
SEED_ADMIN_PASSWORD=Admin@12345            # <REPLACE_FOR_REAL_ADMIN>

# ───────────── Azure OpenAI / AI Foundry (optional — AI is active when all 3 are set) ─────────────
AZURE_OPENAI_ENDPOINT=                     # e.g. https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=                      # <REPLACE_AZURE_OPENAI_KEY>
AZURE_OPENAI_DEPLOYMENT=                   # deployment name, e.g. gpt-4o-mini
